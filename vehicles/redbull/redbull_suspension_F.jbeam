{
"redbull_suspension_F": {
    "information":{
        "authors":"LucasBE",
        "name":"Independent Front Suspension",
        "value":1600,
    },
    "slotType" : "redbull_suspension_F",
    "slots": [
        ["type", "default", "description"],
        ["redbull_brake_F","redbull_brake_F", "Front Brakes"],
        //To change the base track width, edit the trackoffset_F offset in the expression.
        ["wheel_F_RB14","redbull_wheel_01a_13x8_F", "Front Wheels", {"nodeOffset":{"x":0.3275, "y":-1.5247, "z":0.3377}}],
        ["redbull_wheeldata_F","redbull_wheeldata_F", "Front Spindles", {"coreSlot":true}],
        ["redbull_coilover_F","redbull_coilover_F", "Front Coilovers"],
        ["redbull_swaybar_F","redbull_swaybar_F", "Front Sway Bar"],
        ["redbull_steering","redbull_steering", "Steering"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_F", "range", "", "Wheel Alignment", 0.985, 0.97, 1.03, "Camber Adjust", "Adjusts the wheel camber angle", {"subCategory":"Front"}],
        ["$caster_F", "range", "", "Wheel Alignment", 1.018, 0.980, 1.025, "Caster Adjust", "Adjusts forward rake of the steering axis", {"subCategory":"Front"}],
        ["$toe_F", "range", "", "Wheel Alignment", 0.9991, 0.995, 1.005, "Toe Adjust", "Adjusts the toe angle (lower: more toe-in)", {"subCategory":"Front"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //front running gear
         ["redbull_arm_upper_F", ["redbull_uppermounts_F","redbull_upperarm_F"]],
         ["redbull_arm_lower_F", ["redbull_lowermounts_F","redbull_lowerarm_F"]],
         {"deformGroup":"hubs_F", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         ["redbull_hubs_F", ["redbull_hub_F"]],
         {"deformGroup":""},
         //"fake" stuff
         // rb14: no mesh ["redbull_rockers_F", ["redbull_rocker_FR","redbull_rocker_FL","redbull_rockers_F"]],
         {"deformGroup":"hubs_F", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         ["redbull_pushrod_F", ["redbull_pushrod_FR","redbull_pushrod_FL"]],
         {"deformGroup":""},

    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--FRONT INDEPENDENT SUSPENSION--
         {"collision":false},
         {"selfCollision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         //front hub
         {"nodeWeight":1.5},
         ["fh2r",-0.678, -1.5233, 0.2862,{"group":["redbull_hub_F","redbull_pushrod_FR"], "nodeWeight":1}],
         ["fh2l", 0.678, -1.5233, 0.2862,{"group":["redbull_hub_F","redbull_pushrod_FL"], "nodeWeight":1}],
         {"nodeWeight":10.0},
         {"collision":true},
         {"selfCollision":true},
         ["fh1r",-0.7317, -1.5248, 0.2347,{"group":["redbull_hub_F","redbull_lowerarm_F"], "nodeWeight":5}],
         ["fh1l", 0.7317, -1.5248, 0.2347,{"group":["redbull_hub_F","redbull_lowerarm_F"], "nodeWeight":5}],
         {"nodeWeight":5.0},
         {"group":["redbull_hub_F","redbull_upperarm_F"]},
         ["fh4r",-0.6723, -1.5044, 0.4396, {"nodeWeight":4}],
         ["fh4l", 0.6723, -1.5044, 0.4396, {"nodeWeight":4}],
         {"group":["redbull_hub_F","redbull_tierod_F"]},
         //tie rod end
         {"nodeWeight":5.5},
         ["fh3r",-0.7119, -1.5849, 0.4299, {"group":["redbull_hub_F","redbull_tierod_FR"], "nodeWeight":4}],
         ["fh3l", 0.7119, -1.5849, 0.4299, {"group":["redbull_hub_F","redbull_tierod_FL"], "nodeWeight":4}],
         {"nodeWeight":4.0},
         {"group":"redbull_hub_F"},
         {"collision":false},
         {"selfCollision":false},
         ["fh5r",-0.5658, -1.3502, 0.3299, {"nodeWeight":4}],
         ["fh5l", 0.5658, -1.3502, 0.3299, {"nodeWeight":4}],
         
         //rockers
         {"nodeWeight":0.2},
         {"collision":false},
         {"selfCollision":false},
         ["rkf1r",-0.1764, -1.4305, 0.6058,{"group":["redbull_rockers_F","redbull_rocker_FR"]}],
         ["rkf0",   0.0, -1.4273, 0.2731,{"group":["redbull_rockers_F"]}],
         ["rkf1l", 0.1764, -1.4305, 0.6058,{"group":["redbull_rockers_F","redbull_rocker_FL"]}],

         ["fs2r", -0.0945, -1.4635, 0.6299,{"group":["redbull_rockers_F","redbull_rocker_FR","redbull_shock_F","redbull_rollbarlinks_F"]}],
         ["fs2l",  0.0945, -1.4635, 0.6299,{"group":["redbull_rockers_F","redbull_rocker_FL","redbull_shock_F","redbull_rollbarlinks_F"]}],
         ["fps1r",-0.1564, -1.5123, 0.5888,{"group":["redbull_rockers_F","redbull_rocker_FR","redbull_pushrod_FR"]}],
         ["fps1l", 0.1564, -1.5123, 0.5888,{"group":["redbull_rockers_F","redbull_rocker_FL","redbull_pushrod_FL"]}],
         {"collision":true},
         {"selfCollision":true},
         {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":80000, "damp":0, "deform":100000, "strength":400000},
        //rigidify steering arm
        ["fw1rr", "fw1r", "fh1r", "fh3r"],
        ["fw1ll", "fw1l", "fh1l", "fh3l"],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT RUNNING GEAR--
          //double wishbone suspension
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"beamPrecompression":1.0,"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":367500,"beamStrength":1500000},
          {"beamSpring":6000000,"beamDamp":600},
          //front hub
          ["fh4r","fh1r"],
          ["fh4l","fh1l"],
          ["fh4r","fh3r"],
          ["fh4l","fh3l"],
          ["fh1r","fh3r"],
          ["fh1l","fh3l"],
          ["fh1r","fh5r"],
          ["fh1l","fh5l"],
          ["fh3r","fh5r"],
          ["fh3l","fh5l"],
          ["fh4r","fh5r"],
          ["fh4l","fh5l"],

          {"beamSpring":1501000,"beamDamp":100},
          ["fh1r","fh2r"],
          ["fh3r","fh2r"],
          ["fh4r","fh2r"],
          ["fh5r","fh2r"],
          
          ["fh1l","fh2l"],
          ["fh3l","fh2l"],
          ["fh4l","fh2l"],
          ["fh5l","fh2l"],

          //rockers
          {"beamDeform":750500,"beamStrength":50000},
          {"beamSpring":150000,"beamDamp":50},
          ["rkf0","rkf1r"],
          ["rkf0","rkf1l"],
          ["fs2r","rkf1r"],
          ["fs2l","rkf1l"],
          ["fps1r","rkf1r"],
          ["fps1l","rkf1l"],
          ["fs2r", "rkf0"],
          ["fs2l", "rkf0"],
          ["fps1r","rkf0"],
          ["fps1l","rkf0"],
          
          ["fs2r","fps1r"],
          ["fs2l","fps1l"],

          //fix to monocoque
          {"beamDeform":750500,"beamStrength":25000},
          ["rkf1r","fx1r"],
          ["rkf1r","fx1l"],
          ["rkf1r","fx2r"],
          ["rkf1r","fx2l"],
          ["rkf1r","fx3r"],
          ["rkf1r","fx3l"],
          ["rkf1r","fx4r"],
          ["rkf1r","fx4l"],
          
          ["rkf1l","fx1r"],
          ["rkf1l","fx1l"],
          ["rkf1l","fx2r"],
          ["rkf1l","fx2l"],
          ["rkf1l","fx3r"],
          ["rkf1l","fx3l"],
          ["rkf1l","fx4r"],
          ["rkf1l","fx4l"],
          
          ["rkf0","fx1r"],
          ["rkf0","fx1l"],
          ["rkf0","fx2r"],
          ["rkf0","fx2l"],
          ["rkf0","fx3r"],
          ["rkf0","fx3l"],
          ["rkf0","fx4r"],
          ["rkf0","fx4l"],

          //pushrods
          {"beamDeform":750500,"beamStrength":40000},
          {"beamSpring":50000,"beamDamp":50},
          ["fps1r","fh2r",{"breakGroup":"lowerarm_FR","breakGroupType":1,"beamPrecompression":1.0,"beamPrecompressionTime":0.5}],
          ["fps1l","fh2l",{"breakGroup":"lowerarm_FL","breakGroupType":1,"beamPrecompression":1.0,"beamPrecompressionTime":0.5}],

          //attach to wheel
          {"optional":true},
          {"beamSpring":6000000,"beamDamp":600},
          {"beamDeform":450500,"beamStrength":4000500},
          {"breakGroup":"wheel_FR"},
          ["fh1r","fw1r", {"name":"axle_FR"}],
          ["fh3r","fw1r", {"beamSpring":6000000,"beamDamp":600}],
          ["fh4r","fw1r"],
          ["fh5r","fw1r"],
          ["fw2r","fw1r", {"beamSpring":3501000,"beamDamp":50}],
          ["fh1r","fw1rr"],
          ["fh3r","fw1rr", {"beamSpring":6000000,"beamDamp":600}],
          ["fh4r","fw1rr", {"beamDeform":437500}],
          ["fh5r","fw1rr"],
          ["fw2r","fw1rr", {"beamSpring":3501000,"beamDamp":50}],
          {"breakGroup":"wheel_FL"},
          ["fh1l","fw1l", {"name":"axle_FL"}],
          ["fh3l","fw1l", {"beamSpring":6000000,"beamDamp":600}],
          ["fh4l","fw1l"],
          ["fh5l","fw1l"],
          ["fw2l","fw1l", {"beamSpring":3501000,"beamDamp":50}],
          ["fh1l","fw1ll"],
          ["fh3l","fw1ll", {"beamSpring":6000000,"beamDamp":600}],
          ["fh4l","fw1ll", {"beamDeform":437500}],
          ["fh5l","fw1ll"],
          ["fw2l","fw1ll", {"beamSpring":3501000,"beamDamp":50}],
          {"breakGroup":""},
          {"optional":false},

          //lower arm
          {"deformLimitExpansion":1.5},
          {"beamDeform":125500,"beamStrength":5000500},
          {"beamSpring":6000000,"beamDamp":1500},
          
          ["fx2r","fh1r", {"breakGroup":"lowerarm_FR","beamPrecompression":"$caster_F","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["fx2l","fh1l", {"breakGroup":"lowerarm_FL","beamPrecompression":"$caster_F","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["fx1r","fh1r", {"breakGroup":"lowerarm_FR","dampCutoffHz":500}],
          ["fx1l","fh1l", {"breakGroup":"lowerarm_FL","dampCutoffHz":500}],

          //upper arm
          ["fh4r","fx3r", {"breakGroup":"upperarm_FR","dampCutoffHz":500,"beamPrecompression":"$camber_F","beamPrecompressionTime":0.5}],
          ["fh4l","fx3l", {"breakGroup":"upperarm_FL","dampCutoffHz":500,"beamPrecompression":"$camber_F","beamPrecompressionTime":0.5}],
          ["fh4r","fx4r", {"breakGroup":"upperarm_FR","dampCutoffHz":500,"beamPrecompression":"$camber_F","beamPrecompressionTime":0.5}],
          ["fh4l","fx4l", {"breakGroup":"upperarm_FL","dampCutoffHz":500,"beamPrecompression":"$camber_F","beamPrecompressionTime":0.5}],

          {"deformLimit":""},
          {"deformLimitExpansion":""},

          //tethers
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.05, "beamShortBound":0.0, "boundZone":0.15},
          {"beamSpring":150100,"beamDamp":200,"beamDeform":4500500,"beamStrength":750500},
          {"beamLimitSpring":2001000,"beamLimitDamp":2500},
          ["fx1r","fh1r", {"dampCutoffHz":500}],
          ["fx1l","fh1l", {"dampCutoffHz":500}],


          //limiters
          {"optional":false},
          //steering limit
          {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":1.0},
          {"beamSpring":2501000,"beamDamp":250,"beamDeform":75000,"beamStrength":3000000},
          //tierod limit
          {"beamPrecompression":0.85},
          ["fh3r","fx4r",{"breakGroup":"upperarm_FR"}],
          ["fh3l","fx4l",{"breakGroup":"upperarm_FL"}],
          {"beamPrecompression":0.87},
          ["fh3r","fx2r",{"breakGroup":"upperarm_FR"}],
          ["fh3l","fx2l",{"breakGroup":"upperarm_FL"}],
          //rigidifier limit
          {"beamPrecompression":0.83},
          ["fh5r","fx3r",{"breakGroup":"lowerarm_FR"}],
          ["fh5l","fx3l",{"breakGroup":"lowerarm_FL"}],
          {"beamPrecompression":0.82},
          ["fh5r","fx1r",{"breakGroup":"lowerarm_FR"}],
          ["fh5l","fx1l",{"breakGroup":"lowerarm_FL"}],
          {"beamPrecompression":1.0},

          //hard travel limit
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":0,"beamDeform":75000,"beamStrength":300000},
          {"beamLimitSpring":1201000,"beamLimitDamp":2000},
          ["fh1r","fs1", {"breakGroup":["lowerarm_FR","upperarm_FR"],"longBoundRange":0.03,"shortBoundRange":0.034,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["fh1l","fs1", {"breakGroup":["lowerarm_FL","upperarm_FL"],"longBoundRange":0.03,"shortBoundRange":0.034,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          
          //rocker travel limit
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":500,"beamDamp":50,"beamDeform":75000,"beamStrength":300000},
          {"beamLimitSpring":121000,"beamLimitDamp":2000},
          ["mt3","fs2r", {"longBoundRange":0.05,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["mt3","fs2l", {"longBoundRange":0.05,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          

          //hub deformgroup to prevent weird spikes
          {"beamPrecompression":0.99, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":0,"beamDamp":0},
          {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
          {"deformGroup":"hubs_F","deformationTriggerRatio":0.1},
          ["fh1r","fh1l"],
          {"deformGroup":""},

          {"beamPrecompression":1},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //suspension shape
            {"groundModel":"metal"},
            {"dragCoef":0},
            {"group":"redbull_suspension_F"},
            ["fh4r", "fh1r", "fh3r"],
            ["fh4r", "fx3r", "fx4r"], 
            ["fh4r", "fh3r", "fx3r"],
            ["fh1r", "fx2r", "fx1r"],

            ["fx3r", "fh3r", "fh1r"],
            ["fx3r", "fh1r", "fx1r"],
            ["fh4r", "fx4r", "fx2r"],
            ["fh4r", "fx2r", "fh1r"],

            ["fh4l", "fh3l", "fh1l"],
            ["fh4l", "fx4l", "fx3l"],
            ["fh4l", "fx3l", "fh3l"],
            ["fh1l", "fx1l", "fx2l"],
            
            ["fh3l", "fx3l", "fh1l"],
            ["fh1l", "fx3l", "fx1l"],
            ["fx4l", "fh4l", "fx2l"],
            ["fx2l", "fh4l", "fh1l"],
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
    ],
},
"redbull_wheeldata_F": {
    "information":{
        "authors":"LucasBE",
        "name":"Front Spindles",
        "value":0,
    },
    "slotType" : "redbull_wheeldata_F",
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //front
        {"selfCollision":true},
        {"collision":true},
        {"triangleCollision":true},
        {"hubcapBreakGroup":"hubcap_FR"},
        {"hubcapGroup":"hubcap_FR"},
        {"axleBeams":["axle_FR"]},
        ["FR", "wheel_FR", "tire_FR", "fw1rr", "fw1r", 9999, "fh5r", 1, {"torqueCoupling:":"fh1r", "torqueArm:":"fh4r", "torqueArm2:":"fw1rr","steerAxisUp:":"fh4r","steerAxisDown:":"fh1r"}],
        {"hubcapBreakGroup":"hubcap_FL"},
        {"hubcapGroup":"hubcap_FL"},
        {"axleBeams":["axle_FL"]},
        ["FL", "wheel_FL", "tire_FL", "fw1ll", "fw1l", 9999, "fh5l", -1, {"torqueCoupling:":"fh1l", "torqueArm:":"fh4l", "torqueArm2:":"fw1ll","steerAxisUp:":"fh4l","steerAxisDown:":"fh1l"}],
        {"selfCollision":true},
        {"axleBeams":[]},{"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"hubcapBreakGroup":""},
        {"hubcapGroup":""},
        {"enableHubcaps":false},
        {"enableTireLbeams":false},
        {"enableTreadReinfBeams":false},
        {"enableTireReinfBeams":false},
        {"enableTreadReinfBeams":false},
        {"enableTirePeripheryReinfBeams":false},
        {"loadSensitivitySlope":""},
        {"noLoadCoef":""},
        {"fullLoadCoef":""},
        {"frictionCoef":""},
        {"slidingFrictionCoef":""},
        {"softnessCoef":0.5},
        {"treadCoef":1.0},
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["shaft", "spindleFL", "wheelaxleFL", 1, {"connectedWheel":"FL", "breakTriggerBeam":"axle_FL", "uiName":"Front Left Axle", "friction":1.1, "dynamicFriction":0.0028, "electricsName":"wheelaxleFL"}],
        ["shaft", "spindleFR", "wheelaxleFR", 1, {"connectedWheel":"FR", "breakTriggerBeam":"axle_FR", "uiName":"Front Right Axle", "friction":1.1, "dynamicFriction":0.0028, "electricsName":"wheelaxleFR"}],
    ],
},
"redbull_coilover_F": {
    "information":{
        "authors":"LucasBE",
        "name":"Front Coilovers",
        "value":1100,
    },
    "slotType" : "redbull_coilover_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"spring_F", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         // rb14: no mesh ["redbull_spring_FR", ["redbull_shock_FR","redbull_shock_F"]],
         {"deformGroup":"spring_F", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         // rb14: no mesh ["redbull_spring_FL", ["redbull_shock_FL","redbull_shock_F"]],
         {"deformGroup":""},
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_F", "range", "+m", "Suspension", 0, -0.03, 0.03, "Spring Height", "Raises or lowers this end of the car (static ride height)", {"stepDis":0.001, "subCategory":"Front"}],
        ["$spring_F", "range", "N/m", "Suspension", 355000, 150000, 900000, "Spring Rate", "Corner spring stiffness (heave and roll)", {"stepDis":5000, "subCategory":"Front"}],
        ["$damp_bump_F", "range", "N/m/s", "Suspension", 14000, 2000, 40000, "Bump Damping", "Damper rate in compression", {"stepDis":500, "subCategory":"Front"}],
        ["$damp_rebound_F", "range", "N/m/s", "Suspension", 24000, 2000, 60000, "Rebound Damping", "Damper rate in extension", {"stepDis":500, "subCategory":"Front"}],
        ["$heave_spring_F", "range", "N/m", "Suspension", 70000, 0, 300000, "Heave Spring", "Third spring: extra wheel rate when both wheels rise together (aero load), none in roll", {"stepDis":5000, "subCategory":"Front"}],
        ["$packer_F", "range", "m", "Suspension", 0.025, 0.010, 0.050, "Packer Gap", "Wheel travel in bump before the packers (progressive bump stops) engage", {"stepDis":0.001, "subCategory":"Front"}],
    ],
    "rails": {
        "shock_FR":{
            "links:":["fs1r", "fs2r"], "broken:":[], "looped":false, "capped":true},
        "shock_FL":{
            "links:":["fs1l", "fs2l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["fs3r", "shock_FR", true, true, 0.0, 1800000, "FLT_MAX", "FLT_MAX"],
        ["fs3l", "shock_FL", true, true, 0.0, 1800000, "FLT_MAX", "FLT_MAX"],
    ],
    "props": [
        ["func",     "mesh",           "idRef:","idX:","idY:", "baseRotation",            "rotation",            "translation",         "min", "max", "offset", "multiplier"],
        //shocks
        // rb14: no mesh ["", "redbull_shockbottom_FR", "fs1r","fs2r","fs2l",      {"x": 88.942, "y":92.642, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1],
        // rb14: no mesh ["", "redbull_shockbottom_FL", "fs1l","fs2l","fs2r",      {"x": -91.058, "y":-87.358, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1],
        // rb14: no mesh ["", "redbull_shocktop_FR",    "fs2r","fs1r","fs1l",      {"x":  -91.058, "y":87.358, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1],
        // rb14: no mesh ["", "redbull_shocktop_FL",    "fs2l","fs1l","fs1r",      {"x":  88.942, "y":-92.642, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--FRONT SHOCKS--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         //shock mounts
         {"nodeWeight":0.5},
         {"collision":false},
         {"selfCollision":false},
         ["fs1r", -0.0787, -0.9522, 0.6523,{"group":[""]}],
         ["fs1l",  0.0787, -0.9522, 0.6523,{"group":[""]}],
         //flexbody help
         {"nodeWeight":0.2},
         {"nodeWeight":0.2},
         {"collision":false},
         {"selfCollision":false},
         ["fs3r", -0.0882, -1.2558, 0.6384,{"group":["redbull_shock_F"]}],
         ["fs3l",  0.0882, -1.2558, 0.6384,{"group":["redbull_shock_F"]}],

         {"collision":true},
         {"selfCollision":true},
         {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        //heave (third) spring: lengthwise axis on the centreline, hubs as arms
        {"spring":"$=$heave_spring_F*0.5967", "damp":"$=$heave_spring_F*0.5967*0.03", "deform":40000, "strength":9999999},
        ["fh1r", "fs1", "mt3", "fh1l"],
    ],
    "beams": [
