          ["fs1l","mt3"],
          ["fs1l","fx2r"],
          ["fs1l","fx2l"],
          ["fs1l","fx4r"],
          ["fs1l","fx4l"],
          ["fs1l","mt1r"],
          ["fs1l","mt1l"],
          ["fs1l","mt2r"],
          ["fs1l","mt2l"],
          {"deformGroup":""},
          
          {"beamSpring":550000,"beamDamp":50},
          {"beamDeform":600400,"beamStrength":20000},
          ["fs1r","fs3r",{"deformGroup":"spring_F","deformationTriggerRatio":0.002},],
          ["fs1l","fs3l",{"deformGroup":"spring_F","deformationTriggerRatio":0.002},],

          //front springs - non progressive
          {"beamType":"|NORMAL"},
          {"beamDeform":80000,"beamStrength":800000,"deformLimitExpansion":1.2},
          {"beamSpring":"$spring_F","beamDamp":0},
          //{"beamSpring":0,"beamDamp":0},
          //IMPORTANT: if precompressionRange is ~= nil then it supersedes beamPrecompression.
          //The case() is for backwards compatibility for old configs containing the "rideheight_F" variable.
          //To change the base ride height, edit the springheight_F offset in the expression.
          ["fh1r","fs1", {"breakGroup":["lowerarm_FR","upperarm_FR"],"name":"spring_FR", "beamPrecompression":"$=$rideheight_F", "precompressionRange":"$=(($springheight_F + 0.01)*(0.5965*$spring_F + $heave_spring_F/0.5965) + 4890.0)/$spring_F",
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":60,"volumeFactor":1.5,"decayFactor":40,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":2000}],
          ["fh1l","fs1", {"breakGroup":["lowerarm_FL","upperarm_FL"],"name":"spring_FL", "beamPrecompression":"$=$rideheight_F", "precompressionRange":"$=(($springheight_F + 0.01)*(0.5965*$spring_F + $heave_spring_F/0.5965) + 4890.0)/$spring_F",
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":60,"volumeFactor":1.5,"decayFactor":40,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":2000}],
          //damper
          {"beamPrecompression":1, "beamType":"|BOUNDED","beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":"$damp_bump_F"},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["fh1r","fs1", {"breakGroup":["lowerarm_FR","upperarm_FR"],"name":"damper_FR","beamDampFast":"$=$damp_bump_F/3","beamDampRebound":"$damp_rebound_F","beamDampReboundFast":"$=$damp_rebound_F/2","beamDampVelocitySplit":0.5 ,"dampCutoffHz":500}],
          ["fh1l","fs1", {"breakGroup":["lowerarm_FL","upperarm_FL"],"name":"damper_FL","beamDampFast":"$=$damp_bump_F/3","beamDampRebound":"$damp_rebound_F","beamDampReboundFast":"$=$damp_rebound_F/2","beamDampVelocitySplit":0.5,"dampCutoffHz":500}],
          //hard bump stop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":501000,"beamLimitDamp":2000},
          ["fh1r","fs1", {"breakGroup":["lowerarm_FR","upperarm_FR"],"longBoundRange":0.04,"shortBoundRange":"$=$packer_F*0.5965","boundZone":0.012,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["fh1l","fs1", {"breakGroup":["lowerarm_FL","upperarm_FL"],"longBoundRange":0.04,"shortBoundRange":"$=$packer_F*0.5965","boundZone":0.012,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          //fake shock stopper
