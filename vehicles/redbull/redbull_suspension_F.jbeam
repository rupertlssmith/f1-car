          {"beamDeform":294000,"beamStrength":1200000},
          {"beamSpring":8501000,"beamDamp":100},
          //shock mounts
          {"beamDeform":600400,"beamStrength":36000},
          {"beamSpring":150000,"beamDamp":50},
          
          {"deformGroup":"spring_F","deformationTriggerRatio":0.01},
          ["fs1r","mt3"],
          ["fs1r","fx2r"],
          ["fs1r","fx2l"],
          ["fs1r","fx4r"],
          ["fs1r","fx4l"],
          ["fs1r","mt1r"],
          ["fs1r","mt1l"],
