          ["fs2l","fs1l", {"breakGroup":["lowerarm_FL","upperarm_FL"],"deformGroup":"spring_F","deformationTriggerRatio":0.002,"longBoundRange":0.04,"shortBoundRange":0.07,"boundZone":0.02,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
