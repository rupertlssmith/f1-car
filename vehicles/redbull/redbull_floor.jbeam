{
"redbull_floor_groundeffect": {
    "information":{
        "authors":"redbull mod (RB14 conversion)",
        "name":"Ride-Height Sensitive Floor (experimental)",
        "value":5000,
    },
    "slotType" : "redbull_floor_groundeffect",
    "controller": [
        ["fileName"],
        ["redbullGroundEffect", {"floorClA":2.000, "gain":12, "stallHeight":0.018, "stallLoss":0.8, "maxForce":8000, "radius":0.335, "h0F":0.0719, "h0R":0.1221}],
    ],
    "thrusters": [
        ["id1:", "id2:", "factor", "thrustLimit", "control"],
        //more downforce: push down on the car (force on id2, towards id1)
        ["fl2", "fl6", 2880, 2880, "floorGEDown"],
        ["rdiff", "rs1", 5120, 5120, "floorGEDown"],
        //less downforce (too high, or stalled): pull up
        ["fl6", "fl2", 2880, 2880, "floorGEUp"],
        ["rs1", "rdiff", 5120, 5120, "floorGEUp"],
    ],
},
