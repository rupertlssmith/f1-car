        ["type", "default", "description"],
        ["redbull_flywheel","redbull_flywheel_race","Flywheel", {"coreSlot":true}],
        ["redbull_gearset","redbull_gearset_standard","Gear Set", {"coreSlot":true}],
        ["redbull_differential_R","redbull_differential_R", "Rear Differential"],
        ["redbull_suspension_R","redbull_suspension_R", "Rear Suspension"],
        ["redbull_wing_R","redbull_wing_R", "Rear Wing"],
        ["redbull_crashbox","redbull_crashbox", "Crashbox"],
    ],
     "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["frictionClutch", "clutch", "mainEngine", 1],
        ["sequentialGearbox", "gearbox", "clutch", 1],
    ],
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-3.2, 0, 4.15, 3.15, 2.54, 2.12, 1.79, 1.535, 1.32, 1.14],
        "friction": 0.76,
        "dynamicFriction": 0.00076,
        "torqueLossCoef": 0.012,
        "gearboxNode:":["rx2r"],

        "gearWhineCoefsInput":  [0.66, 0.00, 0.33, 0.33, 0.33, 0.33, 0.33, 0.33, 0.33, 0.33],
        "gearWhineCoefsOutput": [0.60, 0.00, 0.80, 0.80, 0.80, 0.80, 0.80, 0.80, 0.80, 0.80],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>straight_01>twine_in_race_sq",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>straight_01>twine_out_race_sq",

        //"forwardInputPitchCoef":1
