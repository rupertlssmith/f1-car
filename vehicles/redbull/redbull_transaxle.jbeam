        //"lowShiftUpRPM":[0,0,9500,9500,9500,9500,9500,9500,9500],
        "lowShiftDownRPM":[0,0,0,6000,6500,6500,6500,6500,6500,6500],
        "lowShiftUpRPM":[0,0,9500,9500,9500,9500,9500,9500,9500],
        //"wheelSlipUpThreshold":100,
        "clutchLaunchStartRPM":7000,
        "clutchLaunchTargetRPM":7500,
        "ignitionCutTime": 0.03
        "revMatchThrottle":1
    },
    "flexbodies": [
