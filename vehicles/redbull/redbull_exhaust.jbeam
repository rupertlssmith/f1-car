{
"redbull_exhaust":{
    "information":{
        "authors":"LucasBE",
        "name":"Muffled Exhaust",
        "value":100,
    },
    "slotType" : "redbull_exhaust",
    "flexbodies":[
        ["mesh", "[group]:","nonFlexMaterials"],
        ["redbull_exhaust", ["redbull_engine","redbull_transaxle"]],
    ],
    "soundConfigExhaust": {
        "$+lowShelfGain":13,
        "$+highShelfGain":-8,
        "$+eqHighGain": 2,
        "$+eqFundamentalGain":1,
    },
    "nodes":[
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":false},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},

         {"nodeWeight":0.4},
         {"group":"redbull_exhaust"},
         ["ex1", -0.2561, 1.54, 0.3069],
         ["ex2",-0.3061, 1.6697, 0.352, {, "afterFireAudioCoef":1.0, "afterFireVisualCoef":0.7, "afterFireVolumeCoef":0.9, "afterFireMufflingCoef":0.80, "exhaustAudioMufflingCoef":0.65, "exhaustAudioGainChange":5}],
         {"group":"none"},
        ],
    "beams":[
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":101000,"beamDamp":90},
          {"beamDeform":90000,"beamStrength":"FLT_MAX"},

          ["ex1", "ex2", {"isExhaust":true}],

          //attach
          {"beamSpring":301000,"beamDamp":50},
          {"beamDeform":75000,"beamStrength":"FLT_MAX"},
          //to engine
          ["ex1", "e1r"],
          ["ex1", "e1l"],
          ["ex1", "e2r", {"isExhaust":true}],
          ["ex1", "e2l"],
          ["ex1", "e3r"],
          ["ex1", "e3l"],
          ["ex1", "e4r"],
          ["ex1", "e4l"],
          
          ["ex2", "e1r"],
          ["ex2", "e1l"],
          ["ex2", "e2r"],
          ["ex2", "e2l"],
          ["ex2", "e3r"],
          ["ex2", "e3l"],
          ["ex2", "e4r"],
          ["ex2", "e4l"],
          
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],

    "triangles":[
        ["id1:", "id2:", "id3:"],
        {"groundModel":"metal"},
        {"group":"redbull_exhaust"},
        {"triangleType":"NONCOLLIDABLE"},
        {"dragCoef":0},
        
        {"triangleType":"NORMALTYPE"},
        ],
