{
"redbull": {
    "information":{
        "authors":"LucasBE",
        "name":"Carbonworks F4",
    },
    "slotType" : "main",
    "slots": [
        ["type", "default", "description"],
        ["redbull_body", "redbull_body", "Body", {"coreSlot":true}],
        ["skin_lbe", "", "Paint Design"],
    ],
    "scaledragCoef":1.6,
    "scalenodeWeight":1.0,
    "scalebeamSpring":1.0,
    "scalebeamDamp":1.0,
    "scalebeamDeform":1.0,
    "scalebeamStrength":1.0,

    "controller": [
        ["fileName"],
        ["vehicleController", {}],
        ["flyBrakeBias", {"startBias": "$brakebias"}]
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakebias", "range", "", "Brakes", 0.55, 0.49, 0.61, "Brake Bias", "Percentage of brake torque going to the front wheels", {"minDis":49, "maxDis":61}],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for this setup", {"minDis":50, "maxDis":150}],
    ],
    "interiorSounds": {
        "rattleModifier": 1.0,
        "dampingModifier": 0.0
    },
    "actionsEnabled": [
        ["id"],
        ["pitLimiter"],
        ["biasPlus"],
        ["biasMinus"],
    ],
},
