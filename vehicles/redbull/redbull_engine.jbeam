        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminum",
        "oilVolume":6,
        "engineBlockAirCoolingEfficiency":40,

        //engine durability
        "cylinderWallTemperatureDamageThreshold":130,
        "headGasketDamageThreshold":4500000,
        "pistonRingDamageThreshold":4500000,
        "connectingRodDamageThreshold":6000000,
        "maxTorqueRating":800,
