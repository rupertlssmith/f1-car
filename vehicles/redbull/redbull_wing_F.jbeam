         ["nc6l", 0.162, -2.5723, 0.4057,{"frictionCoef":0.1}],

         //enticer/rigidifier node
         {"group":""},
         {"nodeWeight":1.0},
         {"collision":false},
         {"selfCollision":false},
         //["nc7", 0.0, -2.12, 0.55],
         
         //--FRONT WING--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":0.25},
