            ["fwg2l","fwg1l","fwg1ll",  {"liftCoef":210, "stallAngle":0.22}],
            //double it and give it to the next person (prevents shit assymetrical forces because wing isn't centered on 1 node, basically just fixing shite beamng aero)
            ["fwg2l","fwg2r","fwg1r",   {"liftCoef":120, "stallAngle":0.22}],
            ["fwg2l","fwg1r","fwg1l",   {"liftCoef":120, "stallAngle":0.22}],
            ["fwg2l","fwg2r","fwg1l",   {"liftCoef":120, "stallAngle":0.22}],
            ["fwg2r","fwg1r","fwg1l",   {"liftCoef":120, "stallAngle":0.22}],
            
            //front wing endplates
            {"groundModel":"metal"},
            {"dragCoef":40},
            {"group":"redbull_wing_F_endplates"},
            ["fep3r","fep4r","fep2r"],
            ["fep3r","fep2r","fep1r"],
            ["fep4l","fep3l","fep2l"],
            ["fep2l","fep3l","fep1l"],
            
            {"group":""},
    ],
},
}