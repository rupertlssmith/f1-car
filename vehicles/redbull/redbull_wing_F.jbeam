    "beams": [
          ["id1:", "id2:"],
          //--FRONT NOSECONE--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":550000,"beamDamp":90},
          {"beamStrength":"FLT_MAX"},
