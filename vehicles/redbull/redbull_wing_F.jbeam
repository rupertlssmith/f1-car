         ["nc1r", "nc2r", "nc2l", "nc3l"],
         ["nc1l", "nc2l", "nc2r", "nc3r"],
 
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_PLASTIC"},
