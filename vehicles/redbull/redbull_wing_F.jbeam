{
"redbull_wing_F": {
    "information":{
        "authors":"LucasBE",
        "name":"Front Wing",
        "value":150,
    },
    "slotType" : "redbull_wing_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["redbull_nose", ["redbull_nose"]],
         ["redbull_wing_F", ["redbull_wing_F"], [], {"pos":{"x": 0.0, "y":-2.2942, "z":0.1419}, "rot":{"x":"$=$wing_angle_F+3", "y":0, "z":0}}],
         ["redbull_endplate_FR", ["redbull_endplate_FR"]],
         ["redbull_endplate_FL", ["redbull_endplate_FL"]],
