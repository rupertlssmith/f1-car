        ["$wing_angle_F", "range", "°", "Aerodynamics", -3.0, -5.0, 2.0, "Front Wing Angle", "Adjusts the front wing's angle of attack", {"stepDis":1, "subCategory":"Front"}],
    ],
    "torsionbars":[
        ["id1:", "id2:", "id3:", "id4:"],
         //stopping the nosecone from bending like a wet spaghet
         //prevent up/down movement
