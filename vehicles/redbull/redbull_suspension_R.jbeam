"redbull_coilover_R": {
    "information":{
        "authors":"LucasBE",
        "name":"Rear Coilovers",
        "value":1400,
    },
    "slotType" : "redbull_coilover_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"spring_R", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         ["redbull_spring_RR", ["redbull_shock_RR","redbull_shock_R"]],
         {"deformGroup":"spring_R", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         ["redbull_spring_RL", ["redbull_shock_RL","redbull_shock_R"]],
         {"deformGroup":""},
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_R", "range", "+m", "Suspension", 0, -0.03, 0.03, "Spring Height", "Raises or lowers this end of the car (static ride height)", {"stepDis":0.001, "subCategory":"Rear"}],
        ["$spring_R", "range", "N/m", "Suspension", 495000, 150000, 900000, "Spring Rate", "Corner spring stiffness (heave and roll)", {"stepDis":5000, "subCategory":"Rear"}]
        ["$damp_bump_R", "range", "N/m/s", "Suspension", 19000, 2000, 40000, "Bump Damping", "Damper rate in compression", {"stepDis":500, "subCategory":"Rear"}]
        ["$damp_rebound_R", "range", "N/m/s", "Suspension", 30000, 2000, 60000, "Rebound Damping", "Damper rate in extension", {"stepDis":500, "subCategory":"Rear"}],
        ["$heave_spring_R", "range", "N/m", "Suspension", 65000, 0, 300000, "Heave Spring", "Third spring: extra wheel rate when both wheels rise together (aero load), none in roll", {"stepDis":5000, "subCategory":"Rear"}],
        ["$packer_R", "range", "m", "Suspension", 0.032, 0.010, 0.050, "Packer Gap", "Wheel travel in bump before the packers (progressive bump stops) engage", {"stepDis":0.001, "subCategory":"Rear"}],
    ],
    "rails": {
        "shock_RR":{
            "links:":["rs1r", "rs2r"], "broken:":[], "looped":false, "capped":true},
        "shock_RL":{
            "links:":["rs1l", "rs2l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["rs3r", "shock_RR", true, true, 0.0, 1800000, "FLT_MAX", "FLT_MAX"],
        ["rs3l", "shock_RL", true, true, 0.0, 1800000, "FLT_MAX", "FLT_MAX"],
    ],
    "props": [
        ["func",     "mesh",           "idRef:","idX:","idY:", "baseRotation",            "rotation",            "translation",         "min", "max", "offset", "multiplier"],
