{
"redbull_suspension_R": {
    "information":{
        "authors":"LucasBE",
        "name":"Independent Rear Suspension",
        "value":1800,
    },
    "slotType" : "redbull_suspension_R",
    "slots": [
        ["type", "default", "description"],
        ["redbull_brake_R","redbull_brake_R", "Rear Brakes"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_R" variable.
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["wheel_R_RB14","redbull_wheel_01a_13x10_R", "Rear Wheels", {"nodeOffset":{"x":0.324, "y":2.03, "z":0.3347}}],
        ["redbull_wheeldata_R","redbull_wheeldata_R", "Rear Spindles", {"coreSlot":true}],
        ["redbull_coilover_R","redbull_coilover_R", "Rear Coilovers"],
        ["redbull_swaybar_R","redbull_swaybar_R", "Rear Sway Bar"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_R", "range", "", "Wheel Alignment", 0.9974, 0.97, 1.03, "Camber Adjust", "Adjusts the wheel camber angles", {"subCategory":"Rear"}],
        ["$toe_R", "range", "", "Wheel Alignment", 0.9928, 0.95, 1.06, "Toe Adjust", "Adjusts the toe angle (lower: more toe-in)", {"subCategory":"Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear running gear
         ["redbull_arm_lower_R", ["redbull_lowermounts_R","redbull_lowerarm_R"]],
         ["redbull_arm_upper_R", ["redbull_uppermounts_R","redbull_upperarm_R"]],
         {"deformGroup":"hubs_R", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         ["redbull_hubs_R", ["redbull_hub_R"]],
         {"deformGroup":""},
         //"fake" stuff
         ["redbull_rocker_RR", ["redbull_rocker_RR"]],
         ["redbull_rocker_RL", ["redbull_rocker_RL"]],
         {"deformGroup":"hubs_R", "deformMaterialBase":"redbull_mechanical", "deformMaterialDamaged":"invis"},
         ["redbull_pushrod_R", ["redbull_pushrod_RR","redbull_pushrod_RL","redbull_pushrod_R"]],
         {"deformGroup":""},
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--REAR INDEPENDENT SUSPENSION--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         //rear hub
         {"nodeWeight":6.0},
         {"group":["redbull_hub_R","redbull_lowerarm_R","redbull_pushrod_R"]},
         ["rh1r",-0.6845, 2.0293, 0.265, {"nodeWeight":5}],
         ["rh1l", 0.6845, 2.0293, 0.265, {"nodeWeight":5}],
         //
         {"nodeWeight":4.5},
         {"group":["redbull_hub_R","redbull_upperarm_R"]},
         ["rh3r",-0.6188, 2.107, 0.4397, {"nodeWeight":4}],
         ["rh3l", 0.6188, 2.107, 0.4397, {"nodeWeight":4}],
         ["rh4r",-0.6188, 1.8952, 0.4411, {"nodeWeight":4}],
         ["rh4l", 0.6188, 1.8952, 0.4411, {"nodeWeight":4}],
         {"nodeWeight":2.5},
         {"group":"redbull_hub_R"},
         //["rh5r",-0.76, 1.12, 0.28],
         //["rh5l", 0.76, 1.12, 0.28],
         {"group":""},
         
         //rockers
         {"nodeWeight":0.2},
         {"collision":false},
         {"selfCollision":false},
         ["rkr1r",-0.1412, 1.8509, 0.5314,{"group":["redbull_rockers_R","redbull_rocker_RR"]}],
         ["rkr0",   0.0, 1.8509, 0.2719,{"group":["redbull_rockers_R","redbull_rocker_RR","redbull_rocker_RL"]}],
         ["rkr1l", 0.1412, 1.8509, 0.5314,{"group":["redbull_rockers_R","redbull_rocker_RL"]}],

         ["rs2r", -0.0537, 1.8126, 0.5277,{"group":["redbull_rockers_R","redbull_rocker_RR","redbull_shock_R","redbull_rollbarlinks_R"]}],
         ["rs2l",  0.0537, 1.8126, 0.5277,{"group":["redbull_rockers_R","redbull_rocker_RL","redbull_shock_R","redbull_rollbarlinks_R"]}],
         ["rps1r",-0.1377, 1.7832, 0.4912,{"group":["redbull_rockers_R","redbull_rocker_RR","redbull_pushrod_RR"]}],
         ["rps1l", 0.1377, 1.7832, 0.4912,{"group":["redbull_rockers_R","redbull_rocker_RL","redbull_pushrod_RL"]}],
         {"collision":true},
         {"selfCollision":true},
         {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":"$=50000*$rear_toe_stiff", "damp":0, "deform":140000, "strength":400000},
        ["rw1rr", "rw1r", "rh3r", "rh4r"],
        ["rw1ll", "rw1l", "rh3l", "rh4l"],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--REAR RUNNING GEAR--
          //multilink suspension
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":453000,"beamStrength":1650000},
          {"beamSpring":"$=6000000*$rear_link_stiff","beamDamp":600},
          //rear hub
          ["rh1r","rh3r"],
          ["rh1r","rh4r"],

          ["rh3r","rh4r"],

          ["rh1l","rh3l"],
          ["rh1l","rh4l"],

          ["rh3l","rh4l"],

          {"beamSpring":1501000,"beamDamp":100},
          //["fh1r","fh2r"],
          //["fh3r","fh2r"],
          //["fh4r","fh2r"],
          //["fh5r","fh2r"],
          //["fh1l","fh2l"],
          //["fh3l","fh2l"],
          //["fh4l","fh2l"],
          //["fh5l","fh2l"],

          //rockers
          {"beamDeform":900600,"beamStrength":60000},
          {"beamSpring":150000,"beamDamp":50},
          ["rkr0","rkr1r"],
          ["rkr0","rkr1l"],
          ["rs2r","rkr1r"],
          ["rs2l","rkr1l"],
          ["rps1r","rkr1r"],
          ["rps1l","rkr1l"],
          ["rs2r", "rkr0"],
          ["rs2l", "rkr0"],
          ["rps1r","rkr0"],
          ["rps1l","rkr0"],
          
          ["rs2r","rps1r"],
          ["rs2l","rps1l"],

          //fix to transaxle
          {"beamDeform":900600,"beamStrength":30000},
          ["rkr1r","rx1r"],
          ["rkr1r","rx1l"],
          ["rkr1r","rx2r"],
          ["rkr1r","rx2l"],
          ["rkr1r","rx3r"],
          ["rkr1r","rx3l"],
          ["rkr1r","rx4r"],
          ["rkr1r","rx4l"],
          
          ["rkr1l","rx1r"],
          ["rkr1l","rx1l"],
          ["rkr1l","rx2r"],
          ["rkr1l","rx2l"],
          ["rkr1l","rx3r"],
          ["rkr1l","rx3l"],
          ["rkr1l","rx4r"],
          ["rkr1l","rx4l"],
          
          ["rkr0","rx1r"],
          ["rkr0","rx1l"],
          ["rkr0","rx2r"],
          ["rkr0","rx2l"],
          ["rkr0","rx3r"],
          ["rkr0","rx3l"],
          ["rkr0","rx4r"],
          ["rkr0","rx4l"],

          //pushrods
          {"beamDeform":900600,"beamStrength":48000},
          {"beamSpring":50000,"beamDamp":50},
          ["rps1r","rh1r",{"breakGroup":"lowerarm_RR","breakGroupType":1,"beamPrecompression":1.0,"beamPrecompressionTime":0.5}],
          ["rps1l","rh1l",{"breakGroup":"lowerarm_RL","breakGroupType":1,"beamPrecompression":1.0,"beamPrecompressionTime":0.5}],

          //attach to wheel
          {"optional":true},
          {"beamSpring":"$=6000000*$rear_link_stiff","beamDamp":600},
          {"beamDeform":540600,"beamStrength":4800600},
          {"breakGroup":"wheel_RR"},
          ["rh1r","rw1r", {"name":"axle_RR"}],
          ["rh3r","rw1r"],
          ["rh4r","rw1r"],
          ["rh5r","rw1r", {"beamSpring":3501000,"beamDamp":125}],

          ["rh1r","rw1rr"],
          ["rh3r","rw1rr"],
          ["rh4r","rw1rr"],
          ["rh5r","rw1rr", {"beamSpring":3501000,"beamDamp":125}],

          {"breakGroup":"wheel_RL"},
          ["rh1l","rw1l", {"name":"axle_RL"}],
          ["rh3l","rw1l"],
          ["rh4l","rw1l"],
          ["rh5l","rw1l", {"beamSpring":3501000,"beamDamp":125}],

          ["rh1l","rw1ll"],
          ["rh3l","rw1ll"],
          ["rh4l","rw1ll"],
          ["rh5l","rw1ll", {"beamSpring":3501000,"beamDamp":125}],
          {"breakGroup":""},
          {"optional":false},

          //lower arm
          {"deformLimitExpansion":1.5},
          {"beamDeform":138600,"beamStrength":6000600},
          {"beamSpring":"$=6000000*$rear_link_stiff","beamDamp":1500},

          ["rx2r","rh1r", {"breakGroup":"lowerarm_RR","dampCutoffHz":500}],
          ["rx2l","rh1l", {"breakGroup":"lowerarm_RL","dampCutoffHz":500}],
          //rear "caster" arms, part of lower arm, adjustable IRL.
          ["rx1r","rh1r", {"breakGroup":"lowerarm_RR","beamPrecompression":1.01,"beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx1l","rh1l", {"breakGroup":"lowerarm_RL","beamPrecompression":1.01,"beamPrecompressionTime":0.5,"dampCutoffHz":500}],

          //upper arm
          ["rx4r","rh3r", {"breakGroup":"upperarm_RR","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx4l","rh3l", {"breakGroup":"upperarm_RL","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3r","rh4r", {"breakGroup":"upperarm_RR","beamPrecompression":"$=$camber_R*$toe_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3l","rh4l", {"breakGroup":"upperarm_RL","beamPrecompression":"$=$camber_R*$toe_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3r","rh3r", {"breakGroup":"upperarm_RR","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3l","rh3l", {"breakGroup":"upperarm_RL","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx4r","rh4r", {"breakGroup":"upperarm_RR","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx4l","rh4l", {"breakGroup":"upperarm_RL","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],

          {"deformLimitExpansion":""},
          
          //tethers
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.05, "beamShortBound":0.0, "boundZone":0.15},
          {"beamSpring":150100,"beamDamp":200,"beamDeform":5400600,"beamStrength":900600},
          {"beamLimitSpring":2001000,"beamLimitDamp":2500},
          ["rx1r","rh1r", {"dampCutoffHz":500}],
          ["rx1l","rh1l", {"dampCutoffHz":500}],

          //rear limiters
          {"beamPrecompression":0.65, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":2501000,"beamDamp":200},
          {"beamDeform":180000,"beamStrength":2400000},

          //"steering" limit
          {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":1.0},
          {"beamSpring":2501000,"beamDamp":250,"beamDeform":270000,"beamStrength":3600000},
          {"beamPrecompression":0.90},
          ["rh3r","rx1r",{"breakGroup":"upperarm_RR"}],
          ["rh3l","rx1l",{"breakGroup":"upperarm_RL"}],
          {"beamPrecompression":0.90},
          ["rh4r","rx2r",{"breakGroup":"upperarm_RR"}],
          ["rh4l","rx2l",{"breakGroup":"upperarm_RL"}],
          
          {"beamPrecompression":1.0},

          //upper arm anti-invert
          {"beamLimitSpring":2001000,"beamLimitDamp":1000},
          {"beamSpring":0,"beamDamp":0,"beamDeform":90000,"beamStrength":1800000},
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.25, "beamShortBound":0.25},
          ["rh4r","rx1r",{"breakGroup":"upperarm_RR"}],
          ["rh4l","rx1l",{"breakGroup":"upperarm_RL"}],
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.15, "beamShortBound":0.15},
          ["rh3r","rx2r",{"breakGroup":"upperarm_RR"}],
          ["rh3l","rx2l",{"breakGroup":"upperarm_RL"}],

          //travel hard limit
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":0,"beamDeform":72000,"beamStrength":900000},
          {"beamLimitSpring":801000,"beamLimitDamp":2000},
          ["rh1r","rs1", {"breakGroup":"lowerarm_RR","longBoundRange":"$=0.03*$rear_droop","shortBoundRange":0.037,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l","rs1", {"breakGroup":"lowerarm_RL","longBoundRange":"$=0.03*$rear_droop","shortBoundRange":0.037,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],

          //rocker travel limit
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":500,"beamDamp":50,"beamDeform":90000,"beamStrength":360000},
          {"beamLimitSpring":121000,"beamLimitDamp":2000},
          ["rx4r","rs2r", {"longBoundRange":0.05,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rx4l","rs2l", {"longBoundRange":0.05,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],

          //hub deformgroup to prevent weird spikes
          {"beamPrecompression":0.99, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":10,"beamDamp":10},
          {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
          {"deformGroup":"hubs_R","deformationTriggerRatio":0.1},
          ["rh1r","rh1l"],
          {"deformGroup":""},

          {"beamPrecompression":1},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //suspension shape
            {"groundModel":"metal"},
            {"dragCoef":0},
            {"group":"redbull_suspension_R"},
            ["rh4r", "rh3r", "rh1r"],
            ["rh3r", "rh4r", "rx4r"],
            ["rx4r", "rh4r", "rx3r"],
            ["rh1r", "rx2r", "rx1r"],
            ["rx2r", "rh3r", "rx4r"],
            ["rh1r", "rh3r", "rx2r"],
            ["rx3r", "rh4r", "rh1r"],
            ["rx3r", "rh1r", "rx1r"],
            
            ["rh4l", "rh1l", "rh3l"],
            ["rx4l", "rh4l", "rh3l"],
            ["rx3l", "rh4l", "rx4l"],
            ["rh1l", "rx1l", "rx2l"],
            ["rh3l", "rx2l", "rx4l"],
            ["rh3l", "rh1l", "rx2l"],
            ["rh4l", "rx3l", "rh1l"],
            ["rh1l", "rx3l", "rx1l"],
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
    ],
},
