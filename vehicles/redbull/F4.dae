  <library_effects>
    <effect id="redbull_rainlight-effect">
      <profile_COMMON>
        <newparam sid="redbull_lights_g_color_png-surface">
          <surface type="2D">
            <init_from>redbull_lights_g_color_png</init_from>
          </surface>
        </newparam>
        <newparam sid="redbull_lights_g_color_png-sampler">
          <sampler2D>
            <source>redbull_lights_g_color_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="redbull_lights_g_color_png-sampler" texcoord="UV1"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
