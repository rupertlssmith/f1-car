{
"redbull_wing_R": {
    "information":{
        "authors":"LucasBE",
        "name":"Rear Wing",
        "value":150,
    },
    "slotType" : "redbull_wing_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"beam_wing_mounts", "deformMaterialBase":"redbull_main", "deformMaterialDamaged":"invis"},
         ["redbull_wing_R_mounts", ["redbull_wingmounts_R","redbull_wing_B"]],
         {"deformGroup":""},
         ["redbull_wing_R", ["redbull_wing_R"], [], {"pos":{"x": 0.0, "y":2.5674, "z":0.9421}, "rot":{"x":"$=$wing_angle_R-8", "y":0, "z":0}}],
         ["redbull_wing_B", ["redbull_wing_B"], [], {"pos":{"x": 0.0, "y":2.3382, "z":0.5701}, "rot":{"x":"$=$wing_angle_B-3", "y":0, "z":0}}],
         ["redbull_endplate_RR", ["redbull_endplate_RR"]],
         ["redbull_endplate_RL", ["redbull_endplate_RL"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$wing_angle_R", "range", "°", "Aerodynamics", 8.0, 0.0, 15.0, "Rear Wing Angle", "Adjusts the upper rear wing's angle of attack", {"stepDis":1, "subCategory":"Rear"}],
        ["$wing_angle_B", "range", "°", "Aerodynamics", 3.0, 0.0, 4.0,  "Beam Wing Angle", "Adjusts the lower rear wing's angle of attack", {"stepDis":1, "subCategory":"Rear"}],
    ],
    "torsionbars":[
        ["id1:", "id2:", "id3:", "id4:"],
        //rigidify wing planes
        {"spring":50000, "damp":5, "deform":20000, "strength":15000},
        ["bwg2r","bwg2","bwg1","bwg1l"],
        ["bwg2l","bwg2","bwg1","bwg1r"],
        ["rwg2r","rwg2","rwg1","rwg1l"],
        ["rwg2l","rwg2","rwg1","rwg1r"],
        ["bwg2r","bwg2","bwg1","bwg1r"],
        ["bwg2l","bwg2","bwg1","bwg1l"],
        ["rwg2r","rwg2","rwg1","rwg1r"],
        ["rwg2l","rwg2","rwg1","rwg1l"],
        
        //rigidify endplates
        {"spring":10000, "damp":5, "deform":20000, "strength":15000},
        ["rep2r","rep1r","rep3r","rep4r"],
        ["rep2l","rep1l","rep3l","rep4l"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--REAR WING--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.6},
         {"group":"redbull_wing_R"},
         ["rwg1r",-0.4372, 2.3512, "$=(($wing_angle_R*-0.005)+0.85)*0.9364+0.1169"],
         ["rwg1",  0.0, 2.3512, "$=(($wing_angle_R*-0.005)+0.85)*0.9364+0.1169"],
         ["rwg1l", 0.4372, 2.3512, "$=(($wing_angle_R*-0.005)+0.85)*0.9364+0.1169"],
         
         ["rwg2r",-0.466, 2.5639, 0.9292],
         ["rwg2",  0.0, 2.5639, 0.9292],
         ["rwg2l", 0.466, 2.5639, 0.9292],
         
         //--BEAM WING--
         {"nodeWeight":0.8},
         {"group":"redbull_wing_B"},
         ["bwg1r",-0.4362, 2.3001, 0.6068],
         ["bwg1",  0.0, 2.3001, 0.6068,{"nodeWeight":0.9}],
         ["bwg1l", 0.4362, 2.3001, 0.6068],
         
         ["bwg2r",-0.4437, 2.4448, "$=(($wing_angle_B*0.005)+0.55)*1.064+0.0429"],
         ["bwg2",  0.0, 2.4448, "$=(($wing_angle_B*0.005)+0.55)*1.064+0.0429"],
         ["bwg2l", 0.4437, 2.4448, "$=(($wing_angle_B*0.005)+0.55)*1.064+0.0429"],


         //--REAR WING ENDPLATES--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":0.6},
         {"group":"redbull_endplate_RR"},
         ["rep1r",-0.4644, 2.2065, 0.5536],
         ["rep2r",-0.4722, 2.4277, 0.394],
         ["rep3r",-0.4648, 2.3257, 0.9412],
         ["rep4r",-0.5029, 2.5639, 0.9385],
         
         {"group":"redbull_endplate_RL"},
         ["rep1l", 0.4644, 2.2065, 0.5536],
         ["rep2l", 0.4722, 2.4277, 0.394],
         ["rep3l", 0.4648, 2.3257, 0.9412],
         ["rep4l", 0.5029, 2.5639, 0.9385],
         

         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //--REAR WING AND BEAM WING--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":603000,"beamDamp":60},
          {"beamDeform":130140,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.1},
          //rear wing and beam wing main shape
          ["rwg1r","rwg2r"],
          ["rwg1","rwg2"],
          ["rwg1l","rwg2l"],
          ["bwg1r","bwg2r"],
          ["bwg1","bwg2"],
          ["bwg1l","bwg2l"],

          //widthwise
          ["rwg1r","rwg1"],
          ["rwg1l","rwg1"],
          ["rwg2r","rwg2"],
          ["rwg2l","rwg2"],
          ["bwg1r","bwg1"],
          ["bwg1l","bwg1"],
          ["bwg2r","bwg2"],
          ["bwg2l","bwg2"],

          //surficial crossing
          {"beamDeform":48600,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          ["rwg1r","rwg2"],
          ["rwg2r","rwg1"],
          ["rwg1l","rwg2"],
          ["rwg2l","rwg1"],
          
          ["bwg1r","bwg2"],
          ["bwg2r","bwg1"],
          ["bwg1l","bwg2"],
          ["bwg2l","bwg1"],

          //rigids
          {"beamDeform":7560,"beamStrength":"FLT_MAX"},
          ["rwg1r","rwg1l"],
          ["rwg2r","rwg2l"],
          ["bwg1r","bwg1l"],
          ["bwg2r","bwg2l"],

          //attach
          {"beamSpring":1500300,"beamDamp":2500},
          {"beamDeform":"FLT_MAX","beamStrength":40400},
          {"breakGroup":"beam_wing_M"},
          {"dampCutoffHz":50},
          {"deformGroup":"beam_wing_mounts","deformationTriggerRatio":0.01},
          ["bwg1","rx4r"],
          ["bwg1","rx4l"],
          ["bwg1","rx2r"],
          ["bwg1","rx2l"],
          ["bwg2","rx4r"],
          ["bwg2","rx4l"],
          ["bwg2","rx2r"],
          ["bwg2","rx2l"],
          ["bwg1","rx3r",{"beamSpring":10100}],
          ["bwg1","rx3l",{"beamSpring":10100}],
          {"beamSpring":903000,"beamDamp":150},
          {"breakGroup":"beam_wing_R"},
          ["bwg1r","rx4r"],
          ["bwg1r","rx2r"],
          ["bwg2r","rx4r"],
          ["bwg2r","rx2r"],
          {"breakGroup":"beam_wing_L"},
          ["bwg1l","rx4l"],
          ["bwg1l","rx2l"],
          ["bwg2l","rx4l"],
          ["bwg2l","rx2l"],
          {"dampCutoffHz":""},
          {"deformGroup":""}

          {"breakGroup":"endplates_BR"},
          {"beamSpring":600300,"beamDamp":50},
          {"beamDeform":"FLT_MAX","beamStrength":28000},
          ["rep1r","bwg1r"],
          ["rep2r","bwg1r"],
          ["rep3r","bwg1r"],
          ["rep4r","bwg1r"],
          ["rep1r","bwg2r"],
          ["rep2r","bwg2r"],
          ["rep3r","bwg2r"],
          ["rep4r","bwg2r"],
          {"beamSpring":1500,"beamDamp":5,"beamDeform":10100,"beamStrength":2000},
          ["rep1r","bwg1"],
          ["rep2r","bwg1"],
          ["rep3r","bwg1"],
          ["rep4r","bwg1"],
          ["rep1r","bwg2"],
          ["rep2r","bwg2"],
          ["rep3r","bwg2"],
          ["rep4r","bwg2"],
          
          {"breakGroup":"endplates_BL"},
          {"beamSpring":600300,"beamDamp":50},
          {"beamDeform":"FLT_MAX","beamStrength":28000},
          ["rep1l","bwg1l"],
          ["rep2l","bwg1l"],
          ["rep3l","bwg1l"],
          ["rep4l","bwg1l"],
          ["rep1l","bwg2l"],
          ["rep2l","bwg2l"],
          ["rep3l","bwg2l"],
          ["rep4l","bwg2l"],
          {"beamSpring":1500,"beamDamp":5,"beamDeform":10100,"beamStrength":2000},
          ["rep1l","bwg1"],
          ["rep2l","bwg1"],
          ["rep3l","bwg1"],
          ["rep4l","bwg1"],
          ["rep1l","bwg2"],
          ["rep2l","bwg2"],
          ["rep3l","bwg2"],
          ["rep4l","bwg2"],
          
          {"breakGroup":"endplates_RR"},
          {"beamSpring":600300,"beamDamp":50},
          {"beamDeform":"FLT_MAX","beamStrength":20000},
          ["rep4r","rwg1r"],
          ["rep1r","rwg2r"],
          ["rep2r","rwg2r"],
          ["rep3r","rwg2r"],
          ["rep4r","rwg2r"],
          {"beamSpring":1500,"beamDamp":5,"beamDeform":10100,"beamStrength":2000},
          ["rep1r","rwg1"],
          ["rep2r","rwg1"],
          ["rep3r","rwg1"],
          ["rep4r","rwg1"],
          ["rep1r","rwg2"],
          ["rep2r","rwg2"],
          ["rep3r","rwg2"],
          ["rep4r","rwg2"],
          
          {"breakGroup":"endplates_RL"},
          {"beamSpring":450300,"beamDamp":50},
          {"beamDeform":"FLT_MAX","beamStrength":20000},
          ["rep4l","rwg1l"],
          ["rep1l","rwg2l"],
          ["rep2l","rwg2l"],
          ["rep3l","rwg2l"],
          ["rep4l","rwg2l"],
          {"beamSpring":1500,"beamDamp":5,"beamDeform":10100,"beamStrength":2000},
          ["rep1l","rwg1"],
          ["rep2l","rwg1"],
          ["rep3l","rwg1"],
          ["rep4l","rwg1"],
          ["rep1l","rwg2"],
          ["rep2l","rwg2"],
          ["rep3l","rwg2"],
          ["rep4l","rwg2"],
          
          {"breakGroup":""},

          //damping
          {"beamType":"|SUPPORT","beamLongBound":5},
          {"beamSpring":0,"beamDamp":200},
          {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
          ["bwg1r","rx3r"],
          ["bwg1l","rx3l"],

          //support
          {"beamType":"|SUPPORT","beamLongBound":8},
          {"beamSpring":213000,"beamDamp":20},
          {"beamDeform":320400,"beamStrength":"FLT_MAX"},
          {"optional":true},
          ["bwg1","cb1r"],
          ["bwg1","cb1l"],
          ["bwg2","cb1r"],
          ["bwg2","cb1l"],
          
          ["bwg1","rx2r"],
          ["bwg1","rx2l"],
          ["bwg2","rx2r"],
          ["bwg2","rx2l"],

          
          //--REAR WING ENDPLATES--
          {"optional":false}
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":603000,"beamDamp":60},
          {"beamDeform":130140,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.1},
          //endplates main shape
          ["rep1r","rep2r"],
          ["rep1r","rep3r"],
          ["rep4r","rep2r"],
          ["rep4r","rep3r"],
          ["rep1l","rep2l"],
          ["rep1l","rep3l"],
          ["rep4l","rep2l"],
          ["rep4l","rep3l"],

          //surficial crossing
          {"beamDeform":48600,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          ["rep1r","rep4r"],
          ["rep2r","rep3r"],
          ["rep1l","rep4l"],
          ["rep2l","rep3l"],

          {"breakGroup":""},
          {"disableTriangleBreaking":false},
          {"optional":false},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
          //pylon (f1_setup.py): swan neck from the trailing edge to the gearbox
          ["rwg2","rx4r", {"beamSpring":1201000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "breakGroup":"wing_R_pylon"}],
          ["rwg2","rx4l", {"beamSpring":1201000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "breakGroup":"wing_R_pylon"}],
          ["rwg2","rx3r", {"beamSpring":1201000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "breakGroup":"wing_R_pylon"}],
          ["rwg2","rx3l", {"beamSpring":1201000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "breakGroup":"wing_R_pylon"}],
    ],
    "hydros": [
        ["id1:", "id2:"],
        //DRS: lifts the leading edge (see tools/rb14/f1_setup.py)
        ["rep1r","rwg1r", {"factor":0.1563, "inputSource":"drs", "inputFactor":1, "inRate":4, "outRate":4, "beamSpring":2001000, "beamDamp":40, "beamDeform":"FLT_MAX", "beamStrength":20000, "breakGroup":"endplates_RR"}],
        ["rep1l","rwg1l", {"factor":0.1563, "inputSource":"drs", "inputFactor":1, "inRate":4, "outRate":4, "beamSpring":2001000, "beamDamp":40, "beamDeform":"FLT_MAX", "beamStrength":20000, "breakGroup":"endplates_RL"}],
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //rear wing
            {"groundModel":"metal"},
            {"dragCoef":1132.5},
            {"group":"redbull_wing_F"},
            ["rwg2","rwg2r","rwg1r",{"liftCoef":267.2, "stallAngle":0.44}],
            ["rwg2","rwg1r","rwg1", {"liftCoef":267.2, "stallAngle":0.44}],
            ["rwg2l","rwg2","rwg1l",{"liftCoef":267.2, "stallAngle":0.44}],
            ["rwg1l","rwg2","rwg1", {"liftCoef":267.2, "stallAngle":0.44}],
            
            //beam wing
            {"dragCoef":588.9},
            {"group":"redbull_wing_F"},
            ["bwg2","bwg2r","bwg1r",{"liftCoef":363.5, "stallAngle":0.27}],
            ["bwg2","bwg1r","bwg1", {"liftCoef":363.5, "stallAngle":0.27}],
            ["bwg2l","bwg2","bwg1l",{"liftCoef":363.5, "stallAngle":0.27}],
            ["bwg1l","bwg2","bwg1", {"liftCoef":363.5, "stallAngle":0.27}],
            
            
            //rear wing endplates
            {"groundModel":"metal"},
            {"dragCoef":181.2},
            {"group":"redbull_wing_R_endplates"},
            ["rep3r","rep4r","rep2r"],
            ["rep3r","rep2r","rep1r"],
            ["rep4l","rep3l","rep2l"],
            ["rep2l","rep3l","rep1l"],
            
            {"group":""},
    ],
},
