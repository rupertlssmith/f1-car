{
"fr04_suspension_R": {
    "information":{
        "authors":"LucasBE",
        "name":"Independent Rear Suspension",
        "value":1800,
    },
    "slotType" : "fr04_suspension_R",
    "slots": [
        ["type", "default", "description"],
        ["fr04_brake_R","fr04_brake_R", "Rear Brakes"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_R" variable.
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["wheel_R_CLF4","fr04_wheel_01a_13x10_R", "Rear Wheels", {"nodeOffset":{"x":0.250, "y":1.5625, "z":0.2743}}],
        ["fr04_wheeldata_R","fr04_wheeldata_R", "Rear Spindles", {"coreSlot":true}],
        ["fr04_coilover_R","fr04_coilover_R", "Rear Coilovers"],
        ["fr04_swaybar_R","fr04_swaybar_R", "Rear Sway Bar"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_R", "range", "", "Wheel Alignment", 0.990, 0.97, 1.03, "Camber Adjust", "Adjusts the wheel camber angles", {"subCategory":"Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear running gear
         ["fr04_arm_lower_R", ["fr04_lowermounts_R","fr04_lowerarm_R"]],
         ["fr04_arm_upper_R", ["fr04_uppermounts_R","fr04_upperarm_R"]],
         {"deformGroup":"hubs_R", "deformMaterialBase":"fr04_mechanical", "deformMaterialDamaged":"invis"},
         ["fr04_hubs_R", ["fr04_hub_R"]],
         {"deformGroup":""},
         //"fake" stuff
         ["fr04_rocker_RR", ["fr04_rocker_RR"]],
         ["fr04_rocker_RL", ["fr04_rocker_RL"]],
         {"deformGroup":"hubs_R", "deformMaterialBase":"fr04_mechanical", "deformMaterialDamaged":"invis"},
         ["fr04_pushrod_R", ["fr04_pushrod_RR","fr04_pushrod_RL","fr04_pushrod_R"]],
         {"deformGroup":""},
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--REAR INDEPENDENT SUSPENSION--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         //rear hub
         {"nodeWeight":6.0},
         {"group":["fr04_hub_R","fr04_lowerarm_R","fr04_pushrod_R"]},
         ["rh1r",-0.645, 1.562, 0.183],
         ["rh1l", 0.645, 1.562, 0.183],
         //
         {"nodeWeight":4.5},
         {"group":["fr04_hub_R","fr04_upperarm_R"]},
         ["rh3r",-0.601, 1.653, 0.373],
         ["rh3l", 0.601, 1.653, 0.373],
         ["rh4r",-0.601, 1.471, 0.373],
         ["rh4l", 0.601, 1.471, 0.373],
         {"nodeWeight":2.5},
         {"group":"fr04_hub_R"},
         //["rh5r",-0.76, 1.12, 0.28],
         //["rh5l", 0.76, 1.12, 0.28],
         {"group":""},
         
         //rockers
         {"nodeWeight":0.2},
         {"collision":false},
         {"selfCollision":false},
         ["rkr1r",-0.121, 1.441, 0.456,{"group":["fr04_rockers_R","fr04_rocker_RR"]}],
         ["rkr0",   0.00, 1.441, 0.194,{"group":["fr04_rockers_R","fr04_rocker_RR","fr04_rocker_RL"]}],
         ["rkr1l", 0.121, 1.441, 0.456,{"group":["fr04_rockers_R","fr04_rocker_RL"]}],

         ["rs2r", -0.046, 1.415, 0.452,{"group":["fr04_rockers_R","fr04_rocker_RR","fr04_shock_R","fr04_rollbarlinks_R"]}],
         ["rs2l",  0.046, 1.415, 0.452,{"group":["fr04_rockers_R","fr04_rocker_RL","fr04_shock_R","fr04_rollbarlinks_R"]}],
         ["rps1r",-0.118, 1.395, 0.418,{"group":["fr04_rockers_R","fr04_rocker_RR","fr04_pushrod_RR"]}],
         ["rps1l", 0.118, 1.395, 0.418,{"group":["fr04_rockers_R","fr04_rocker_RL","fr04_pushrod_RL"]}],
         {"collision":true},
         {"selfCollision":true},
         {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":50000, "damp":0, "deform":35000, "strength":100000},
        ["rw1rr", "rw1r", "rh3r", "rh4r"],
        ["rw1ll", "rw1l", "rh3l", "rh4l"],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--REAR RUNNING GEAR--
          //multilink suspension
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":75500,"beamStrength":275000},
          {"beamSpring":8001000,"beamDamp":125},
          //rear hub
          ["rh1r","rh3r"],
          ["rh1r","rh4r"],

          ["rh3r","rh4r"],

          ["rh1l","rh3l"],
          ["rh1l","rh4l"],

          ["rh3l","rh4l"],

          {"beamSpring":1501000,"beamDamp":100},
          //["fh1r","fh2r"],
          //["fh3r","fh2r"],
          //["fh4r","fh2r"],
          //["fh5r","fh2r"],
          //["fh1l","fh2l"],
          //["fh3l","fh2l"],
          //["fh4l","fh2l"],
          //["fh5l","fh2l"],

          //rockers
          {"beamDeform":150100,"beamStrength":10000},
          {"beamSpring":150000,"beamDamp":50},
          ["rkr0","rkr1r"],
          ["rkr0","rkr1l"],
          ["rs2r","rkr1r"],
          ["rs2l","rkr1l"],
          ["rps1r","rkr1r"],
          ["rps1l","rkr1l"],
          ["rs2r", "rkr0"],
          ["rs2l", "rkr0"],
          ["rps1r","rkr0"],
          ["rps1l","rkr0"],
          
          ["rs2r","rps1r"],
          ["rs2l","rps1l"],

          //fix to transaxle
          {"beamDeform":150100,"beamStrength":5000},
          ["rkr1r","rx1r"],
          ["rkr1r","rx1l"],
          ["rkr1r","rx2r"],
          ["rkr1r","rx2l"],
          ["rkr1r","rx3r"],
          ["rkr1r","rx3l"],
          ["rkr1r","rx4r"],
          ["rkr1r","rx4l"],
          
          ["rkr1l","rx1r"],
          ["rkr1l","rx1l"],
          ["rkr1l","rx2r"],
          ["rkr1l","rx2l"],
          ["rkr1l","rx3r"],
          ["rkr1l","rx3l"],
          ["rkr1l","rx4r"],
          ["rkr1l","rx4l"],
          
          ["rkr0","rx1r"],
          ["rkr0","rx1l"],
          ["rkr0","rx2r"],
          ["rkr0","rx2l"],
          ["rkr0","rx3r"],
          ["rkr0","rx3l"],
          ["rkr0","rx4r"],
          ["rkr0","rx4l"],

          //pushrods
          {"beamDeform":150100,"beamStrength":8000},
          {"beamSpring":50000,"beamDamp":50},
          ["rps1r","rh1r",{"breakGroup":"lowerarm_RR","breakGroupType":1,"beamPrecompression":"$=($springheight_R + 1.04)","beamPrecompressionTime":0.5}],
          ["rps1l","rh1l",{"breakGroup":"lowerarm_RL","breakGroupType":1,"beamPrecompression":"$=($springheight_R + 1.04)","beamPrecompressionTime":0.5}],

          //attach to wheel
          {"optional":true},
          {"beamSpring":9001000,"beamDamp":125},
          {"beamDeform":90100,"beamStrength":800100},
          {"breakGroup":"wheel_RR"},
          ["rh1r","rw1r", {"name":"axle_RR"}],
          ["rh3r","rw1r"],
          ["rh4r","rw1r"],
          ["rh5r","rw1r", {"beamSpring":3501000,"beamDamp":125}],

          ["rh1r","rw1rr"],
          ["rh3r","rw1rr"],
          ["rh4r","rw1rr"],
          ["rh5r","rw1rr", {"beamSpring":3501000,"beamDamp":125}],

          {"breakGroup":"wheel_RL"},
          ["rh1l","rw1l", {"name":"axle_RL"}],
          ["rh3l","rw1l"],
          ["rh4l","rw1l"],
          ["rh5l","rw1l", {"beamSpring":3501000,"beamDamp":125}],

          ["rh1l","rw1ll"],
          ["rh3l","rw1ll"],
          ["rh4l","rw1ll"],
          ["rh5l","rw1ll", {"beamSpring":3501000,"beamDamp":125}],
          {"breakGroup":""},
          {"optional":false},

          //lower arm
          {"deformLimitExpansion":1.5},
          {"beamDeform":23100,"beamStrength":1000100},
          {"beamSpring":9001000,"beamDamp":1500},

          ["rx2r","rh1r", {"breakGroup":"lowerarm_RR","dampCutoffHz":500}],
          ["rx2l","rh1l", {"breakGroup":"lowerarm_RL","dampCutoffHz":500}],
          //rear "caster" arms, part of lower arm, adjustable IRL.
          ["rx1r","rh1r", {"breakGroup":"lowerarm_RR","beamPrecompression":1.01,"beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx1l","rh1l", {"breakGroup":"lowerarm_RL","beamPrecompression":1.01,"beamPrecompressionTime":0.5,"dampCutoffHz":500}],

          //upper arm
          ["rx4r","rh3r", {"breakGroup":"upperarm_RR","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx4l","rh3l", {"breakGroup":"upperarm_RL","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3r","rh4r", {"breakGroup":"upperarm_RR","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3l","rh4l", {"breakGroup":"upperarm_RL","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3r","rh3r", {"breakGroup":"upperarm_RR","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx3l","rh3l", {"breakGroup":"upperarm_RL","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx4r","rh4r", {"breakGroup":"upperarm_RR","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
          ["rx4l","rh4l", {"breakGroup":"upperarm_RL","beamPrecompression":"$camber_R","beamPrecompressionTime":0.5,"dampCutoffHz":500}],

          {"deformLimitExpansion":""},
          
          //tethers
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.05, "beamShortBound":0.0, "boundZone":0.15},
          {"beamSpring":150100,"beamDamp":200,"beamDeform":900100,"beamStrength":150100},
          {"beamLimitSpring":2001000,"beamLimitDamp":2500},
          ["rx1r","rh1r", {"dampCutoffHz":500}],
          ["rx1l","rh1l", {"dampCutoffHz":500}],

          //rear limiters
          {"beamPrecompression":0.65, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":2501000,"beamDamp":200},
          {"beamDeform":30000,"beamStrength":400000},

          //"steering" limit
          {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":1.0},
          {"beamSpring":2501000,"beamDamp":250,"beamDeform":45000,"beamStrength":600000},
          {"beamPrecompression":0.90},
          ["rh3r","rx1r",{"breakGroup":"upperarm_RR"}],
          ["rh3l","rx1l",{"breakGroup":"upperarm_RL"}],
          {"beamPrecompression":0.90},
          ["rh4r","rx2r",{"breakGroup":"upperarm_RR"}],
          ["rh4l","rx2l",{"breakGroup":"upperarm_RL"}],
          
          {"beamPrecompression":1.0},

          //upper arm anti-invert
          {"beamLimitSpring":2001000,"beamLimitDamp":1000},
          {"beamSpring":0,"beamDamp":0,"beamDeform":15000,"beamStrength":300000},
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.25, "beamShortBound":0.25},
          ["rh4r","rx1r",{"breakGroup":"upperarm_RR"}],
          ["rh4l","rx1l",{"breakGroup":"upperarm_RL"}],
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.15, "beamShortBound":0.15},
          ["rh3r","rx2r",{"breakGroup":"upperarm_RR"}],
          ["rh3l","rx2l",{"breakGroup":"upperarm_RL"}],

          //travel hard limit
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":0,"beamDeform":12000,"beamStrength":150000},
          {"beamLimitSpring":801000,"beamLimitDamp":2000},
          ["rh1r","rs1", {"breakGroup":"lowerarm_RR","longBoundRange":0.03,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l","rs1", {"breakGroup":"lowerarm_RL","longBoundRange":0.03,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],

          //rocker travel limit
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":500,"beamDamp":50,"beamDeform":15000,"beamStrength":60000},
          {"beamLimitSpring":121000,"beamLimitDamp":2000},
          ["rx4r","rs2r", {"longBoundRange":0.05,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rx4l","rs2l", {"longBoundRange":0.05,"shortBoundRange":0.05,"boundZone":0.016,"beamLimitDampRebound":0,"dampCutoffHz":500}],

          //hub deformgroup to prevent weird spikes
          {"beamPrecompression":0.99, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":10,"beamDamp":10},
          {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
          {"deformGroup":"hubs_R","deformationTriggerRatio":0.1},
          ["rh1r","rh1l"],
          {"deformGroup":""},

          {"beamPrecompression":1},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //suspension shape
            {"groundModel":"metal"},
            {"dragCoef":0},
            {"group":"fr04_suspension_R"},
            ["rh4r", "rh3r", "rh1r"],
            ["rh3r", "rh4r", "rx4r"],
            ["rx4r", "rh4r", "rx3r"],
            ["rh1r", "rx2r", "rx1r"],
            ["rx2r", "rh3r", "rx4r"],
            ["rh1r", "rh3r", "rx2r"],
            ["rx3r", "rh4r", "rh1r"],
            ["rx3r", "rh1r", "rx1r"],
            
            ["rh4l", "rh1l", "rh3l"],
            ["rx4l", "rh4l", "rh3l"],
            ["rx3l", "rh4l", "rx4l"],
            ["rh1l", "rx1l", "rx2l"],
            ["rh3l", "rx2l", "rx4l"],
            ["rh3l", "rh1l", "rx2l"],
            ["rh4l", "rx3l", "rh1l"],
            ["rh1l", "rx3l", "rx1l"],
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
    ],
},
"fr04_wheeldata_R": {
    "information":{
        "authors":"LucasBE",
        "name":"Rear Spindles",
        "value":0,
    },
    "slotType" : "fr04_wheeldata_R",
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //rear
        {"selfCollision":true},
        {"collision":true},
        {"triangleCollision":true},
        {"hubcapBreakGroup":"hubcap_RR"},
        {"hubcapGroup":"hubcap_RR"},
        {"axleBeams":["axle_RR"]},
        ["RR", "wheel_RR", "tire_RR", "rw1rr", "rw1r", 9999, "rh1r", 1, {"torqueCoupling:":"tra1", "torqueArm:":"rdiff","torqueArm2:":"e1r"}],
        {"hubcapBreakGroup":"hubcap_RL"},
        {"hubcapGroup":"hubcap_RL"},
        {"axleBeams":["axle_RL"]},
        ["RL", "wheel_RL", "tire_RL", "rw1ll", "rw1l", 9999, "rh1l", -1, {"torqueCoupling:":"tra1", "torqueArm:":"rdiff","torqueArm2:":"e1l"}],
        {"selfCollision":true},
        {"axleBeams":[]},{"disableMeshBreaking":false,"disableTriangleBreaking":false},
