        ["shaft", "spindleRL", "wheelaxleRL", 1, {"connectedWheel":"RL", "breakTriggerBeam":"axle_RL", "uiName":"Rear Left Axle", "friction":1.22, "dynamicFriction":0.0031, "electricsName":"wheelaxleRL"}],
        ["shaft", "spindleRR", "wheelaxleRR", 1, {"connectedWheel":"RR", "breakTriggerBeam":"axle_RR", "uiName":"Rear Right Axle", "friction":1.22, "dynamicFriction":0.0031, "electricsName":"wheelaxleRR"}],
    ],
},
"fr04_coilover_R": {
    "information":{
        "authors":"LucasBE",
        "name":"Rear Coilovers",
        "value":1400,
    },
    "slotType" : "fr04_coilover_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"spring_R", "deformMaterialBase":"fr04_mechanical", "deformMaterialDamaged":"invis"},
         ["fr04_spring_RR", ["fr04_shock_RR","fr04_shock_R"]],
         {"deformGroup":"spring_R", "deformMaterialBase":"fr04_mechanical", "deformMaterialDamaged":"invis"},
         ["fr04_spring_RL", ["fr04_shock_RL","fr04_shock_R"]],
         {"deformGroup":""},
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_R", "range", "+m", "Suspension", 0, -0.06, 0.04, "Spring Height", "Raise or lower the suspension height", {"stepDis":0.005, "subCategory":"Rear"}],
        ["$spring_R", "range", "N/m", "Suspension", 100000, 20000, 300000, "Spring Rate", "Spring stiffness", {"stepDis":5000, "subCategory":"Rear"}]
        ["$damp_bump_R", "range", "N/m/s", "Suspension", 7000, 500, 15000, "Bump Damping", "Damper rate in compression", {"stepDis":100, "subCategory":"Rear"}]
        ["$damp_rebound_R", "range", "N/m/s", "Suspension", 12000, 500, 30000, "Rebound Damping", "Damper rate in extension", {"stepDis":100, "subCategory":"Rear"}]
    ],
    "rails": {
        "shock_RR":{
            "links:":["rs1r", "rs2r"], "broken:":[], "looped":false, "capped":true},
        "shock_RL":{
            "links:":["rs1l", "rs2l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["rs3r", "shock_RR", true, true, 0.0, 1800000, "FLT_MAX", "FLT_MAX"],
        ["rs3l", "shock_RL", true, true, 0.0, 1800000, "FLT_MAX", "FLT_MAX"],
    ],
    "props": [
        ["func",     "mesh",           "idRef:","idX:","idY:", "baseRotation",            "rotation",            "translation",         "min", "max", "offset", "multiplier"],
        //shocks
        ["", "fr04_shockbottom_RR", "rs1r","rs2r","rs2l",  {"x":0, "y":1, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1, {"baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["", "fr04_shockbottom_RL", "rs1l","rs2l","rs2r",  {"x":0, "y":1, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1, {"baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["", "fr04_shocktop_RR",    "rs2r","rs1r","rs1l",  {"x":0, "y":1, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1, {"baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["", "fr04_shocktop_RL",    "rs2l","rs1l","rs1r",  {"x":0, "y":1, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -1000, 1000, 0, 1, {"baseRotationGlobal":{"x":0, "y":0, "z":0}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--REAR SHOCKS--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         //shock mounts
         {"nodeWeight":0.5},
         {"collision":false},
         {"selfCollision":false},
         ["rs1r", -0.038, 1.737, 0.430,{"group":[""]}],
         ["rs1l",  0.038, 1.737, 0.430,{"group":[""]}],
         //flexbody help
         {"nodeWeight":0.2},
         {"nodeWeight":0.2},
         {"collision":false},
         {"selfCollision":false},
         ["rs3r", -0.043, 1.543, 0.444,{"group":["fr04_shock_RR"]}],
         ["rs3l",  0.043, 1.543, 0.444,{"group":["fr04_shock_RL"]}],

         {"collision":true},
         {"selfCollision":true},
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1.0,"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":73500,"beamStrength":300000},
          {"beamSpring":8501000,"beamDamp":100},
          //shock mounts
          {"beamDeform":150100,"beamStrength":9000},
          {"beamSpring":150000,"beamDamp":50},
          
          {"deformGroup":"spring_R","deformationTriggerRatio":0.01},
          ["rs1r","rs1"],
          ["rs1r","rx2r"],
          ["rs1r","rx2l"],
          ["rs1r","rx4r"],
          ["rs1r","rx4l"],
          ["rs1r","rx1r"],
          ["rs1r","rx1l"],
          ["rs1r","rx3r"],
          ["rs1r","rx3l"],
          
          {"deformGroup":"spring_R","deformationTriggerRatio":0.01},
          ["rs1l","rs1"],
          ["rs1l","rx2r"],
          ["rs1l","rx2l"],
          ["rs1l","rx4r"],
          ["rs1l","rx4l"],
          ["rs1l","rx1r"],
          ["rs1l","rx1l"],
          ["rs1l","rx3r"],
          ["rs1l","rx3l"],
          {"deformGroup":""},
          
          {"beamSpring":550000,"beamDamp":50},
          {"beamDeform":150100,"beamStrength":5000},
          ["rs1r","rs3r",{"deformGroup":"spring_R","deformationTriggerRatio":0.002},],
          ["rs1l","rs3l",{"deformGroup":"spring_R","deformationTriggerRatio":0.002},],

          //rear springs, non progressive
          {"beamType":"|NORMAL"},
          {"beamDeform":20000,"beamStrength":200000,"deformLimitExpansion":1.2},
          {"beamSpring":"$spring_R","beamDamp":0},
          //To change the base ride height, edit the springheight_R offset in the expression.
          ["rh1r","rs1", {"breakGroup":"lowerarm_RR","name":"spring_RR", "beamPrecompression":"$=$rideheight_R","precompressionRange":"$=($springheight_R + 0.10)*0.45",
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":60,"volumeFactor":1.6,"decayFactor":40,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":4300}],
          ["rh1l","rs1", {"breakGroup":"lowerarm_RL","name":"spring_RL", "beamPrecompression":"$=$rideheight_R","precompressionRange":"$=($springheight_R + 0.10)*0.45",
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":60,"volumeFactor":1.6,"decayFactor":40,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":4300}],
          //damper
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":"$damp_bump_R"},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["rh1r","rs1", {"breakGroup":"lowerarm_RR","name":"damper_RR","beamDampFast":"$=$damp_bump_R/3","beamDampRebound":"$damp_rebound_R","beamDampReboundFast":"$=$damp_rebound_R/2","beamDampVelocitySplit":0.5,"dampCutoffHz":500}],
          ["rh1l","rs1", {"breakGroup":"lowerarm_RL","name":"damper_RL","beamDampFast":"$=$damp_bump_R/3","beamDampRebound":"$damp_rebound_R","beamDampReboundFast":"$=$damp_rebound_R/2","beamDampVelocitySplit":0.5,"dampCutoffHz":500}],
          //hard bumpstop
          {"beamSpring":0,"beamDamp":0},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamLimitSpring":501000,"beamLimitDamp":2000},
          ["rh1r","rs1", {"breakGroup":"lowerarm_RR","longBoundRange":0.04,"shortBoundRange":0.085,"boundZone":0.02,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l","rs1", {"breakGroup":"lowerarm_RL","longBoundRange":0.04,"shortBoundRange":0.085,"boundZone":0.02,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          //fake shock stopper
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":501000,"beamLimitDamp":2000},
          ["rs2r","rs1r", {"breakGroup":["lowerarm_RR","upperarm_RR"],"deformGroup":"spring_R","deformationTriggerRatio":0.002,"longBoundRange":0.04,"shortBoundRange":0.07,"boundZone":0.02,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rs2l","rs1l", {"breakGroup":["lowerarm_RL","upperarm_RL"],"deformGroup":"spring_R","deformationTriggerRatio":0.002,"longBoundRange":0.04,"shortBoundRange":0.07,"boundZone":0.02,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
